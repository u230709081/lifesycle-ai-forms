# Copy to .env and set a server-side key for AI functions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
PORT=3000

# Optional audio transcription support
OPENAI_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional Lifesycle CRM integration: endpoint must return JSON contact/property fields.
LIFESYCLE_RECORD_URL=
LIFESYCLE_API_TOKEN=
